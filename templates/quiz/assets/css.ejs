<%- include($shared('base/css')) _%>

body {
   width: 100vw;
   display: flex;
   align-items: center;
   justify-content: center;
   height: 100vh;
}

#card-holder, .card {
   border-radius: 6px;
}

#card-holder {
   width: 400px;
   height: 300px;
   border: var(--border);
   cursor: pointer;
   margin-bottom: 20px;
}

#card-back, #card-front {
   width: 100%;
   height: 100%;
}

.front .content {
   width: 100%;
   height: 100%;
}

.hidden {
   display: none;
}

.buttons {
   text-align: center;
   margin: 0 auto;
   width: 100%;
}

button {
   padding: 10px;
   width: 100px;
   margin: 0 5px;
}

.card tfoot b {
   float: right;
}


input {
   font-size: inherit;
}

.col, .row {
   display: flex;
   flex-wrap: wrap;
   align-items: center;
   gap: 0.5rem;
}

.col {
   flex-direction: column;
}

.chapter-checkbox {
   width: fit-content;
   gap: 0;
}

.root {
   display: flex;
   align-items: center;
   gap: 1rem;
}

@media (min-aspect-ratio: 3/4) {
   .root {
      flex-direction: column;
   }
}

@media (min-aspect-ratio: 4/3) {
   .root {
      flex-direction: row;
   }
}

