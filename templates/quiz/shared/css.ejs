<%- include($shared('base/css')) _%>

#card-holder {
   width: 400px;
   height: 300px;
   margin: 50px auto;
   border: var(--border);
   cursor: default;
   user-select: none;
}

#card-back, #card-front {
   width: 100%;
   height: 100%;
}

.front .content {
   width: 100%;
   height: 100%;
}

.hidden {
   display: none;
}

.buttons {
   text-align: center;
   margin: 0 auto;
   width: 100%;
}

button {
   padding: 10px;
   width: 100px;
   margin: 0 5px;
}

